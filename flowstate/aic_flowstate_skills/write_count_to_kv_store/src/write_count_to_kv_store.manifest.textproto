}
options {
  supports_cancellation: false
  cc_config {
    create_skill: "::WriteCountToKVStore::CreateSkill"
  }
}
parameter {
  message_full_name: "ai.flowstate.WriteCountToKVStoreParams"
  default_value: {
    type_url: "type.googleapis.com/ai.flowstate.WriteCountToKVStoreParams"
  }
}
return_type {
  message_full_name: "ai.flowstate.WriteCountToKVStoreResult"
}
