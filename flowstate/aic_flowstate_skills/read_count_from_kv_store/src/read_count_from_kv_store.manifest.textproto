}
options {
  supports_cancellation: false
  cc_config {
    create_skill: "::ReadCountFromKVStore::CreateSkill"
  }
}
parameter {
  message_full_name: "ai.flowstate.ReadCountFromKVStoreParams"
  default_value: {
    type_url: "type.googleapis.com/ai.flowstate.ReadCountFromKVStoreParams"
  }
}
return_type {
  message_full_name: "ai.flowstate.ReadCountFromKVStoreResult"
}
