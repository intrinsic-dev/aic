<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypathens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>aic_logger</name>
  <version>0.1.0</version>
  <description>Flowstate ROS 2 recording service using rosbag2</description>
  <maintainer email="aaronchong@google.com">Aaron Chong</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rosbag2_cpp</depend>
  <depend>rosbag2_transport</depend>
  <depend>rosbag2_storage</depend>
  <depend>rosbag2_storage_mcap</depend>
  <depend>std_srvs</depend>

  <exec_depend>rosidl_default_runtime</exec_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
