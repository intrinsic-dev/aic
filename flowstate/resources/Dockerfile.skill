FROM ubuntu:24.04 AS pixi-builder

# Install prerequisites
RUN apt-get update && apt-get install -y \
    curl \
    git \
    patch \
    build-essential \
    python3 \
    libxml2-dev \
    liblttng-ust-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Pixi
RUN curl -fsSL https://pixi.sh/install.sh | PIXI_VERSION=0.67.2 bash
ENV PATH="/root/.pixi/bin:${PATH}"

WORKDIR /workspace

# Pre-cache Pixi environment
COPY src/aic/pixi.toml src/aic/pixi.lock src/aic/robostack_mapping.json ./
# Copy path-dependent local packages for Pixi validation
COPY src/aic/aic_interfaces/ ./aic_interfaces/
COPY src/aic/aic_example_policies/ ./aic_example_policies/
COPY src/aic/aic_model/ ./aic_model/
COPY src/aic/aic_utils/ ./aic_utils/
RUN pixi install --frozen --environment skill-build && pixi install --frozen --environment skill-runtime


# Pre-build SDK to optimize caching of heavy dependencies
FROM pixi-builder AS sdk-builder
COPY src/sdk-ros/ ./sdk-ros/
RUN pixi run --frozen --environment skill-build colcon build \
    --merge-install \
    --cmake-args -DCMAKE_BUILD_TYPE=Release \
    --event-handlers=console_direct+ \
    --packages-up-to intrinsic_sdk \
    --base-paths sdk-ros

# Final build stage for user code overlay
FROM sdk-builder AS build

ARG SKILL_PACKAGE
ARG DEPENDENCIES

# Copy target user packages
COPY src/aic/flowstate/ ./flowstate/
COPY src/aic/aic_adapter/ ./aic_adapter/

# Build target skill package using existing install space
RUN pixi run --frozen --environment skill-build colcon build \
    --merge-install \
    --cmake-args -DCMAKE_BUILD_TYPE=Release \
    --event-handlers=console_direct+ \
    --packages-up-to ${SKILL_PACKAGE} \
    --base-paths flowstate aic_adapter sdk-ros aic_interfaces

# Capture pixi environment activation for runtime
RUN pixi shell-hook --frozen --environment skill-runtime > /pixi_hook.sh \
    && rm -rf /root/.pixi/cache /root/.cache/pixi /workspace/.pixi/cache \
    && if [ -d /workspace/build/pybind11_abseil_vendor/pybind11_abseil_vendor-prefix/src/pybind11_abseil_vendor-build ]; then \
        mkdir -p /workspace/install/opt/bindings && \
        cp -r /workspace/build/pybind11_abseil_vendor/pybind11_abseil_vendor-prefix/src/pybind11_abseil_vendor-build /workspace/install/opt/bindings/pybind11_abseil; \
    fi

# Runtime stage
FROM ubuntu:24.04 AS runtime

ARG SKILL_PACKAGE
ARG SKILL_NAME
ARG SKILL_EXECUTABLE_NAME
ARG DEPENDENCIES

RUN apt-get update && apt-get install -y \
    bash \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

# Copy Pixi environment and built artifacts
COPY --from=build /workspace/.pixi/envs/skill-runtime /workspace/.pixi/envs/skill-runtime
RUN ln -s /workspace/.pixi/envs/skill-runtime /workspace/.pixi/envs/skill-build
COPY --from=build /workspace/install ./install
COPY --from=build /pixi_hook.sh /pixi_hook.sh

# Bridge paths for build_bundle.sh expectations
RUN mkdir -p /opt/ros/overlay \
    && ln -sf /workspace/install /opt/ros/overlay/install

# Environment variables for skill execution
ENV PYTHONPATH="/workspace/install/opt/bindings/pybind11_abseil:/workspace/install/lib/python3.12/site-packages"
ENV LD_LIBRARY_PATH="/workspace/install/opt/bindings/pybind11_abseil:/workspace/install/lib"
ENV SKILL_PACKAGE=${SKILL_PACKAGE}
ENV SKILL_NAME=${SKILL_NAME}
ENV SKILL_EXEC_PATH="/workspace/install/lib/${SKILL_PACKAGE}/${SKILL_EXECUTABLE_NAME}"
ENV SKILL_CONFIG="share/${SKILL_PACKAGE}/${SKILL_NAME}_config.pbbin"

# Create runner script activating Pixi and setting overrides
RUN echo '#!/bin/bash' > /run_skill.sh \
    && echo 'set -e' >> /run_skill.sh \
    && echo 'source /pixi_hook.sh' >> /run_skill.sh \
    && echo 'source /workspace/install/setup.bash' >> /run_skill.sh \
    && echo 'export RMW_IMPLEMENTATION=rmw_zenoh_cpp' >> /run_skill.sh \
    && echo 'export ROS_HOME=/tmp' >> /run_skill.sh \
    && echo 'export ZENOH_CONFIG_OVERRIDE="connect/endpoints=[\"tcp/zenoh-router.app-intrinsic-base.svc.cluster.local:7447\"]"' >> /run_skill.sh \
    && echo 'exec "$SKILL_EXEC_PATH" "$@"' >> /run_skill.sh \
    && chmod +x /run_skill.sh

# Setup /skills directory layout expected by Intrinsic runtime
RUN mkdir -p /skills \
    && ln -sf /run_skill.sh /skills/skill_service \
    && ln -sf /workspace/install/$SKILL_CONFIG /skills/skill_service_config.proto.bin

LABEL "ai.intrinsic.asset-id"="ai.intrinsic.${SKILL_PACKAGE}"
ENV ZENOH_ROUTER_CHECK_ATTEMPTS=-1

CMD ["/skills/skill_service", "--skill_service_config_filename=/skills/skill_service_config.proto.bin"]
