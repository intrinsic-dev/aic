<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>aic_logging</name>
  <version>0.1.0</version>
  <description>External ROS 2 logging and Zenoh router configuration for AIC</description>
  <maintainer email="aaronchong@google.com">aaronchong</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>ros2bag</exec_depend>
  <exec_depend>rosbag2_cpp</exec_depend>
  <exec_depend>rosbag2_storage_mcap</exec_depend>
  <exec_depend>rosbag2_transport</exec_depend>
  <exec_depend>rmw_zenoh_cpp</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
